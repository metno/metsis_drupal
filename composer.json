{
    "name": "metno/metsis_drupal",
    "type": "drupal-custom-module",
    "description": "METSIS Drupal module providing search and metadata export functionality for METSIS.",
    "keywords": [
        "Drupal",
        "custom module",
        "Search API",
        "Solr",
        "MMD",
        "OPEnDAP",
        "WMS",
        "METSIS"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Magnar Martinsen",
            "email": "magnarem@met.no"
        }
    ],
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan",
        "test": "phpunit"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "require": {
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "sweetrdf/easyrdf": "^1",
        "drupal/search_api": "^1.41",
        "drupal/search_api_solr": "^4.4",
        "drupal/vite": "^1.5",
        "drupal/facets": "^3.0",
        "drupal/search_api_autocomplete": "^1.10",
        "drupal/better_exposed_filters": "^7",
        "drupal/redis": "^1",
        "drupal/leaflet": "^10.4",
        "drupal/views_ajax_history": "^1.8",
        "drupal/views_filters_summary": "^3.2",
        "drupal/tagify": "^2",
        "drupal/honeypot": "^2.2",
        "metno/mmd": "^4"
    },
    "suggest": {
        "drupal/back_to_top": "Add back to top icon on scrolling",
        "drupal/extlink": "Add icon to external links",
        "drupal/markdown": "Render help page README.md with markdown parser",
        "drupal/views_dependent_filter": "Allow filters to depend on values of other filters"
    },
    "require-dev": {
        "drupal/devel": "^4.0 || ^5.0",
        "drush/drush": "^13",
        "drupal/webprofiler": "^11",
        "drupal/config_devel": "^1.10",
        "drupal/log_stdout": "^3.0",
        "kint-php/kint": "^6",
        "firephp/firephp-core": "^0.5.3",
        "symfony/var-dumper": "^4 || ^5 || ^6 || ^7",
        "drupal/kint": "^2.3",
        "drupal/core-dev": "^10.5 || ^11 || ^11.3",
        "drupal/pathauto": "^1.13",
        "phpunit/php-code-coverage": "^9.2 || ^10.0 || ^11.0 || ^12.0",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/htmx": "^2.0",
        "friendsoftwig/twigcs": "*",
        "drupal/solo": "^1.0",
        "twig/twig": "3.29.0",
        "wikimedia/composer-merge-plugin": "^2.1",
        "phpstan/phpstan": "*",
        "phpstan/extension-installer": "*",
        "phpstan/phpstan-deprecation-rules": "*",
        "drupal/config_inspector": "^2.1",
        "drupal/editoria11y": "^3",
        "rector/rector": "^2",
        "drupal/d8w3css": "^2",
        "drupal/markdown": "^3.1",
        "league/commonmark": "^2.8",
        "brianium/paratest": "^7",
        "phpdocumentor/shim": "^3",
        "drupal/sdc_devel": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupalspoons/composer-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true,
            "phpdocumentor/shim": true,
            "symfony/runtime": true
        }
    }
}
