<?php

/**
 * @file
 * Deterministic result rows for responsive browser tests.
 */

declare(strict_types=1);

use Drupal\Core\Url;
use Drupal\search_api\Entity\Index;
use Drupal\search_api\Item\Item;
use Drupal\search_api\Plugin\views\ResultRow;
use Drupal\views\ViewExecutable;
use Solarium\QueryType\Select\Result\Document;

/**
 * Implements hook_views_data_alter().
 */
function metsis_map_test_views_data_alter(array &$data): void {
  // The mock backend cannot supply Solr's dynamic DateRange handler mapping.
  $data['search_api_index_metsis']['temporal_extent_period_dr']['filter']['id'] = 'metsis_filter_date_range';
}

/**
 * Implements hook_views_pre_render().
 */
function metsis_map_test_views_pre_render(ViewExecutable $view): void {
  if ($view->id() === 'metsis_search' && \Drupal::state()->get('metsis_map_test.row_popovers')) {
    $item = new Item(Index::load('metsis'), 'solr_document/popover-test');
    $item->setExtraData('search_api_solr_document', new Document([
      'id' => 'popover-test',
      'metadata_identifier' => 'popover-test',
      'title' => 'Popover contrast fixture',
      'data_access_json' => [
        ['type' => 'HTTP', 'resource' => 'https://example.test/data.nc'],
        ['type' => 'OPeNDAP', 'resource' => 'https://example.test/dodsC/data'],
      ],
    ]));
    $view->rowPlugin->options['style'] = 'default';
    $view->rowPlugin->options['show_operations'] = TRUE;
    $view->attachment_after[] = $view->rowPlugin->render(new ResultRow(['_item' => $item]));
  }

  if ($view->id() !== 'metsis_search' || !\Drupal::state()->get('metsis_map_test.responsive_rows')) {
    return;
  }

  foreach (['with-map', 'without-map'] as $variant) {
    $fields = [
      'id' => 'responsive-' . $variant,
      'metadata_identifier' => 'responsive-' . $variant,
      'title' => str_repeat('DatasetTitle', 12),
      'abstract' => ['#markup' => str_repeat('<p>A long abstract for testing responsive search result expansion and wrapping.</p>', 30)],
      'parent' => TRUE,
      'license_text' => [
        '#type' => 'link',
        '#title' => 'https://example.test/' . str_repeat('license', 30),
        '#url' => Url::fromUri('https://example.test/license'),
      ],
    ];
    if ($variant === 'with-map') {
      $fields['thumbnail'] = [
        '#theme' => 'image',
        '#uri' => 'core/misc/druplicon.png',
        '#alt' => 'Dataset thumbnail',
        '#width' => 180,
        '#height' => 180,
      ];
    }
    $view->attachment_after[] = [
      '#theme' => 'metsis_search_row_default',
      '#fields' => $fields,
      '#operations' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['metsis-row-operations']],
        'controls' => [
          '#type' => 'container',
          '#attributes' => ['class' => ['metsis-row-operations-controls']],
          'collection' => [
            '#type' => 'component',
            '#component' => 'metsis_drupal:icon_button',
            '#slots' => [
              'button' => [
                '#type' => 'button',
                '#value' => '144036 of 144036 children found',
                '#attributes' => ['class' => ['metsis-collection-button']],
              ],
            ],
          ],
        ],
      ],
    ];
  }
}
