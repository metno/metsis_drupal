<?php

/**
 * @file
 * Contains metsis_search install logic.
 */

/**
 * Implements hook_install().
 */
function metsis_search_install() {
  module_set_weight('metsis_search', 11);
}

/**
 * Implements hook_uninstall().
 *
 * All configuration shipped in config/install and config/optional (Search API
 * server, indexes, facets, views, blocks, date formats, sort fields, and the
 * autocomplete config) is removed automatically by Drupal's uninstall process
 * because the module owns those config objects. Facet block placements are
 * deleted explicitly before their facets so placements on every theme are
 * removed as well.
 *
 * This hook invalidates cached render output so stale search result pages and
 * blocks are not served after the module is removed.  Solr indexed documents
 * are intentionally left intact.
 */
function metsis_search_uninstall(bool $is_syncing = FALSE): void {
  // Explicitly delete only the configuration objects shipped by this module
  // that match the requested config domains.
  $module_path = \Drupal::service('extension.list.module')->getPath('metsis_search');
  $config_dirs = [
    $module_path . '/config/install',
    $module_path . '/config/optional',
  ];

  // Deletion order matters: remove dependents before their dependencies.
  $prefix_order = [
    'views.view.',
    'facets.facet_source.',
    'search_api.index.',
    'search_api.server.',
  ];

  $config_to_delete = [];
  foreach ($prefix_order as $prefix) {
    $config_to_delete[$prefix] = [];
  }
  $facet_ids = [];

  foreach ($config_dirs as $dir) {
    if (!is_dir($dir)) {
      continue;
    }
    $entries = scandir($dir);
    if ($entries === FALSE) {
      continue;
    }
    foreach ($entries as $entry) {
      if (!str_ends_with($entry, '.yml')) {
        continue;
      }
      $config_name = pathinfo($entry, PATHINFO_FILENAME);
      if (str_starts_with($config_name, 'facets.facet.')) {
        $facet_ids[] = substr($config_name, strlen('facets.facet.'));
        continue;
      }
      foreach ($prefix_order as $prefix) {
        if (str_starts_with($config_name, $prefix)) {
          $config_to_delete[$prefix][$config_name] = $config_name;
          break;
        }
      }
    }
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $deleted_blocks = 0;
  $deleted_facets = 0;
  $block_storage = $entity_type_manager->getStorage('block');
  $facet_storage = $entity_type_manager->getStorage('facets_facet');
  foreach (array_unique($facet_ids) as $facet_id) {
    $blocks = $block_storage->loadByProperties([
      'plugin' => 'facet_block:' . $facet_id,
    ]);
    if ($blocks) {
      $deleted_blocks += count($blocks);
      $block_storage->delete($blocks);
    }

    $facet = $facet_storage->load($facet_id);
    if ($facet) {
      $facet->delete();
      $deleted_facets++;
    }
  }

  $config_factory = \Drupal::configFactory();
  $deleted = 0;
  foreach ($prefix_order as $prefix) {
    foreach ($config_to_delete[$prefix] as $config_name) {
      $config = $config_factory->getEditable($config_name);
      if (!$config->isNew()) {
        $config->delete();
        $deleted++;
      }
    }
  }

  // Invalidate render cache entries so stale search blocks and result pages
  // produced by this module are not served from cache.
  \Drupal::cache('render')->invalidateAll();

  \Drupal::logger('metsis_search')->notice(
    'metsis_search uninstalled. Deleted @count module-owned configuration '
    . 'objects, including @facets facets, and @blocks facet block placements. '
    . 'Solr index data has been preserved (must be cleared manually if required).',
    [
      '@count' => $deleted + $deleted_facets,
      '@facets' => $deleted_facets,
      '@blocks' => $deleted_blocks,
    ]
  );
}

/**
 * Update function.
 */
function metsis_search_update_9303() {
  $host = \Drupal::request()->getHost();
  if ((strpos($host, 'nbs') === FALSE) || (strpos($host, 'satellittdata') === FALSE)) {
    \Drupal::logger('metsis_search')->notice('Updating metsis search configuration');
    $config_factory = \Drupal::configFactory();
    $config = $config_factory->getEditable('metsis_search.settings');
    $config->set('score_parent', TRUE);
    $config->save(TRUE);
  }
}
